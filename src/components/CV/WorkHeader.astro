---
type Props = {
  title: string;
  organization: string;
  location?: string;
  start: string;
  end?: string;
};

const { title, organization, location, start, end } = Astro.props;
---

<article class="entry">
  <div class="row">
    <h3 class="title">{title}</h3>
    <span class="dates text-slate-200">{start}{end && <> &mdash; {end}</>}</span>
  </div>
  <div class="row">
    <span class="org text-slate-200">{organization}</span>
    {location && <em class="location text-slate-200">{location}</em>}
  </div>
  <div class="details"><slot /></div>
</article>

<style>
  .entry {
    /* Computer Modern look, with sensible fallbacks */
    font-size: 1rem;
    line-height: 1.35;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .title {
    margin: 0;
    font-size: inherit;
    font-weight: 700;
  }

  .dates,
  .org {
    font-weight: 400;
  }

  .location {
    font-style: italic;
  }

  .details:not(:empty) {
    margin-top: 0.25rem;
  }

  /* Stack on narrow screens so nothing collides */
  @media (max-width: 480px) {
    .row {
      flex-direction: column;
      gap: 0;
    }
  }

  @media print {
    .entry {
      break-inside: avoid;
    }
  }
</style>
